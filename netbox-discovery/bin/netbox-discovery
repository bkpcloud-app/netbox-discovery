#!/bin/bash
set -euo pipefail

BASE="${NETBOX_DISCOVERY_BASE:-/opt/netbox-discovery}"
PYTHON="${PYTHON:-/usr/bin/python3}"
COMMAND="${1:-help}"
shift || true

require_root() {
  if [[ "$(id -u)" != "0" ]]; then
    echo "ERRO: este comando exige root." >&2
    exit 1
  fi
}

check_product() {
  "$PYTHON" "$BASE/modules/product/selftest.py" --base "$BASE"
  if [[ ! -f "$BASE/config.yml" ]]; then
    echo "CONFIG: ainda não criada"
    echo "Execute: netbox-discovery init"
    return 0
  fi
  "$PYTHON" - <<'PY'
import os, sys
base = os.environ.get('NETBOX_DISCOVERY_BASE', '/opt/netbox-discovery')
sys.path.insert(0, base)
from lib.config import load_config
cfg = load_config()
site = (cfg.get('discovery') or {}).get('site', '')
print('CONFIG: OK')
print('TENANT: {0}'.format(cfg.get('tenant', '')))
print('SITE: {0}'.format(site))
print('NETBOX URL: {0}'.format((cfg.get('netbox') or {}).get('url', '')))
for name in ('networks_file', 'exclusions_file', 'communities_file'):
    path = (cfg.get('discovery') or {}).get(name, '')
    if path and not os.path.isfile(path):
        raise RuntimeError('{0} não encontrado: {1}'.format(name, path))
print('DISCOVER V5: OK')
print('CLASSIFY V8: OK')
print('RECONCILE V5: OK')
print('PLAN V11: OK')
print('IMPORT V12: OK')
print('AUDIT V11: OK')
PY
}

set_network_automation_enabled() {
  local enabled="$1"
  "$PYTHON" - "$enabled" <<'PY'
import os, sys
path = os.path.join(os.environ.get('NETBOX_DISCOVERY_BASE','/opt/netbox-discovery'), 'config.yml')
enabled = sys.argv[1].lower() == 'true'
if not os.path.isfile(path):
    raise SystemExit('ERRO: config.yml não existe')
rows = open(path, 'r').read().splitlines()
out = []
in_auto = False
changed = False
for row in rows:
    stripped = row.strip()
    indent = len(row) - len(row.lstrip())
    if indent == 0 and stripped.endswith(':'):
        in_auto = stripped == 'automation:'
    if in_auto and indent > 0 and stripped.startswith('enabled:'):
        out.append('  enabled: ' + ('true' if enabled else 'false'))
        changed = True
    else:
        out.append(row)
if not changed:
    raise SystemExit('ERRO: automation.enabled não encontrado em config.yml')
tmp = path + '.tmp'
with open(tmp, 'w') as f:
    f.write('\n'.join(out) + '\n')
os.chmod(tmp, 0o600)
os.replace(tmp, path)
PY
}

scheduler_enable() {
  require_root
  local schedule
  schedule=$("$PYTHON" - <<'PY'
import os,sys
base=os.environ.get('NETBOX_DISCOVERY_BASE','/opt/netbox-discovery')
sys.path.insert(0,base)
from lib.config import load_config
cfg=load_config()
print((cfg.get('automation') or {}).get('schedule') or 'daily')
PY
)
  mkdir -p /etc/systemd/system/netbox-discovery.timer.d
  cat > /etc/systemd/system/netbox-discovery.timer.d/schedule.conf <<EOF
[Timer]
OnCalendar=
OnCalendar=$schedule
EOF
  set_network_automation_enabled true
  systemctl daemon-reload
  systemctl enable --now netbox-discovery.timer
  echo "SCHEDULER: HABILITADO"
  echo "OnCalendar: $schedule"
}

scheduler_disable() {
  require_root
  set_network_automation_enabled false
  systemctl disable --now netbox-discovery.timer || true
  echo "SCHEDULER: DESABILITADO"
}

hypervisor_deps_install() {
  require_root

  local need_vmware=0
  local need_hyperv=0
  local type
  for type in "$@"; do
    case "$type" in
      vmware) need_vmware=1 ;;
      hyperv) need_hyperv=1 ;;
      all) need_vmware=1; need_hyperv=1 ;;
      proxmox|'') ;;
      *) echo "ERRO: tipo de conector Hypervisor inválido: $type" >&2; return 1 ;;
    esac
  done

  if [[ "$need_vmware" -eq 0 && "$need_hyperv" -eq 0 ]]; then
    return 0
  fi

  local vendor="$BASE/vendor"
  local packages=('six==1.16.0')

  if [[ "$need_vmware" -eq 1 ]]; then
    packages+=('pyvmomi==7.0.3')
  fi

  if [[ "$need_hyperv" -eq 1 ]]; then
    packages+=(
      'requests==2.27.1'
      'urllib3==1.26.18'
      'charset-normalizer==2.0.12'
      'idna==3.6'
      'certifi==2024.2.2'
      'cryptography==3.4.8'
      'pywinrm==0.4.3'
      'requests-ntlm==1.1.0'
      'ntlm-auth==1.5.0'
      'xmltodict==0.13.0'
    )
  fi

  local fingerprint marker
  fingerprint=$(printf '%s\n' "vmware=$need_vmware" "hyperv=$need_hyperv" "${packages[@]}" | sha256sum | awk '{print $1}')
  marker="$vendor/.requirements.sha256"

  validate_vendor() {
    local path="$1"
    NEED_VMWARE="$need_vmware" NEED_HYPERV="$need_hyperv" \
      PYTHONPATH="$path${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON" - <<'PYDEPS'
import os
if os.environ.get('NEED_VMWARE') == '1':
    import pyVmomi
if os.environ.get('NEED_HYPERV') == '1':
    import winrm
print('HYPERVISOR DEPS: OK')
PYDEPS
  }

  if [[ -f "$marker" ]] && [[ "$(cat "$marker" 2>/dev/null || true)" == "$fingerprint" ]]; then
    if validate_vendor "$vendor" >/dev/null 2>&1; then
      return 0
    fi
  fi

  if ! "$PYTHON" -m pip --version >/dev/null 2>&1; then
    echo "Instalando python3-pip para conectores Hypervisor..."
    if command -v dnf >/dev/null 2>&1; then dnf install -y python3-pip
    elif command -v yum >/dev/null 2>&1; then yum install -y python3-pip
    elif command -v apt-get >/dev/null 2>&1; then apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y python3-pip
    else echo "ERRO: não foi possível instalar python3-pip." >&2; return 1
    fi
  fi

  local tmp pip_bootstrap
  tmp="$(mktemp -d "$BASE/vendor.tmp.XXXXXX")"
  pip_bootstrap="$(mktemp -d "$BASE/pip-bootstrap.tmp.XXXXXX")"

  cleanup_hypervisor_deps_tmp() {
    rm -rf "$tmp" "$pip_bootstrap"
  }

  echo "Preparando instalador Python compatível com Python 3.6..."
  if ! "$PYTHON" -m pip install --disable-pip-version-check --no-cache-dir --target "$pip_bootstrap" \
      'pip==21.3.1' 'setuptools==59.6.0' 'wheel==0.37.1'; then
    cleanup_hypervisor_deps_tmp
    echo "ERRO: falha ao preparar pip compatível; vendor atual foi preservado." >&2
    return 1
  fi

  if [[ "$need_vmware" -eq 1 && "$need_hyperv" -eq 1 ]]; then
    echo "Preparando dependências VMware + Hyper-V isoladas..."
  elif [[ "$need_vmware" -eq 1 ]]; then
    echo "Preparando dependências VMware isoladas..."
  else
    echo "Preparando dependências Hyper-V isoladas..."
  fi

  if ! PYTHONPATH="$pip_bootstrap${PYTHONPATH:+:$PYTHONPATH}" \
      "$PYTHON" -m pip install --disable-pip-version-check --no-cache-dir --target "$tmp" "${packages[@]}"; then
    cleanup_hypervisor_deps_tmp
    echo "ERRO: falha ao instalar dependências Hypervisor; vendor atual foi preservado." >&2
    return 1
  fi

  if ! validate_vendor "$tmp"; then
    cleanup_hypervisor_deps_tmp
    echo "ERRO: validação das dependências Hypervisor falhou; vendor atual foi preservado." >&2
    return 1
  fi

  printf '%s\n' "$fingerprint" > "$tmp/.requirements.sha256"
  rm -rf "$vendor.old"
  [[ -d "$vendor" ]] && mv "$vendor" "$vendor.old"
  if ! mv "$tmp" "$vendor"; then
    [[ -d "$vendor.old" ]] && mv "$vendor.old" "$vendor"
    cleanup_hypervisor_deps_tmp
    echo "ERRO: não foi possível ativar vendor Hypervisor." >&2
    return 1
  fi
  rm -rf "$vendor.old" "$pip_bootstrap"
}

hypervisor_deps_from_config() {
  local types
  types=$("$PYTHON" - <<'PYTYPES'
import os,sys
base=os.environ.get('NETBOX_DISCOVERY_BASE','/opt/netbox-discovery')
sys.path.insert(0,base)
from modules.hypervisor.config import load_hypervisor_config, enabled_sources
cfg=load_hypervisor_config(required=True)
print(' '.join(sorted(set(str(x.get('type') or '').lower() for x in enabled_sources(cfg)))))
PYTYPES
)
  # shellcheck disable=SC2086
  hypervisor_deps_install $types
}

set_hypervisor_automation_enabled() {
  local enabled="$1"
  "$PYTHON" - "$enabled" <<'PY'
import os,sys
base=os.environ.get('NETBOX_DISCOVERY_BASE','/opt/netbox-discovery')
sys.path.insert(0,base)
from modules.hypervisor.config import load_hypervisor_config, save_hypervisor_config
cfg=load_hypervisor_config(required=True)
cfg.setdefault('automation', {})['enabled'] = sys.argv[1].lower() == 'true'
save_hypervisor_config(cfg)
PY
}

hypervisor_scheduler_enable() {
  require_root
  local schedule
  schedule=$("$PYTHON" - <<'PYSCHED'
import os,sys
base=os.environ.get('NETBOX_DISCOVERY_BASE','/opt/netbox-discovery')
sys.path.insert(0,base)
from modules.hypervisor.config import load_hypervisor_config
cfg=load_hypervisor_config(required=True)
print((cfg.get('automation') or {}).get('schedule') or 'daily')
PYSCHED
)
  mkdir -p /etc/systemd/system/netbox-discovery-hypervisor.timer.d
  cat > /etc/systemd/system/netbox-discovery-hypervisor.timer.d/schedule.conf <<EOF
[Timer]
OnCalendar=
OnCalendar=$schedule
EOF
  set_hypervisor_automation_enabled true
  systemctl daemon-reload
  systemctl enable --now netbox-discovery-hypervisor.timer
  echo "HYPERVISOR SCHEDULER: HABILITADO"
  echo "OnCalendar: $schedule"
}

hypervisor_scheduler_disable() {
  require_root
  set_hypervisor_automation_enabled false
  systemctl disable --now netbox-discovery-hypervisor.timer || true
  echo "HYPERVISOR SCHEDULER: DESABILITADO"
}

update_dispatch() {
  local action="${1:-status}"
  shift || true
  case "$action" in
    status|check|run|scheduled)
      exec "$PYTHON" "$BASE/modules/product/updater.py" "$action" "$@"
      ;;
    scheduler)
      local sched="${1:-status}"
      case "$sched" in
        enable) require_root; systemctl enable --now netbox-discovery-update.timer; echo "AUTO UPDATE: HABILITADO" ;;
        disable) require_root; systemctl disable --now netbox-discovery-update.timer; echo "AUTO UPDATE: DESABILITADO" ;;
        status) systemctl status netbox-discovery-update.timer --no-pager || true ;;
        *) echo "Uso: netbox-discovery update scheduler {enable|disable|status}" >&2; exit 2 ;;
      esac
      ;;
    *) echo "Uso: netbox-discovery update {status|check|run|scheduled|scheduler}" >&2; exit 2 ;;
  esac
}

hypervisor_dispatch() {
  local action="${1:-help}"
  shift || true
  case "$action" in
    help|-h|--help)
      cat <<'EOF'
netbox-discovery hypervisor - inventário de virtualização

Uso:
  netbox-discovery hypervisor configure
  netbox-discovery hypervisor check
  netbox-discovery hypervisor run [--apply]
  netbox-discovery hypervisor status
  netbox-discovery hypervisor scheduler {enable|disable|status}

Segurança:
  hypervisor run         = coleta + PLAN, sem escrita
  hypervisor run --apply = coleta + PLAN + IMPORT + AUDIT
  nunca renomeia objetos existentes e nunca apaga automaticamente
EOF
      ;;
    configure|init) exec "$PYTHON" "$BASE/modules/hypervisor/configurator_v2.py" "$@" ;;
    check) hypervisor_deps_from_config; exec "$PYTHON" "$BASE/modules/hypervisor/checker.py" "$@" ;;
    run) hypervisor_deps_from_config; exec "$PYTHON" "$BASE/modules/hypervisor/runner.py" "$@" ;;
    scheduled-run) hypervisor_deps_from_config; exec "$PYTHON" "$BASE/modules/hypervisor/runner.py" --scheduled ;;
    _ensure-deps) hypervisor_deps_install "${1:-all}" ;;
    status) exec "$PYTHON" "$BASE/modules/hypervisor/status.py" "$@" ;;
    scheduler)
      local sched="${1:-status}"
      case "$sched" in
        enable) hypervisor_scheduler_enable ;;
        disable) hypervisor_scheduler_disable ;;
        status) systemctl status netbox-discovery-hypervisor.timer --no-pager || true ;;
        *) echo "Uso: netbox-discovery hypervisor scheduler {enable|disable|status}" >&2; exit 2 ;;
      esac
      ;;
    *) echo "Comando hypervisor inválido: $action" >&2; exit 2 ;;
  esac
}

case "$COMMAND" in
  version|--version|-V) cat "$BASE/VERSION" ;;
  help|-h|--help)
    cat <<'EOF'
netbox-discovery - inventário de rede para NetBox

Uso:
  netbox-discovery init
  netbox-discovery configure
  netbox-discovery check
  netbox-discovery self-test
  netbox-discovery health [--json]
  netbox-discovery discover
  netbox-discovery classify
  netbox-discovery reconcile
  netbox-discovery plan
  netbox-discovery inventory
  netbox-discovery import [--apply]
  netbox-discovery audit
  netbox-discovery run [--apply]
  netbox-discovery status
  netbox-discovery scheduler {enable|disable|status}
  netbox-discovery hypervisor {configure|check|run|status|scheduler}
  netbox-discovery update {status|check|run|scheduler}
  netbox-discovery version

Segurança:
  run              = DISCOVER -> CLASSIFY -> RECONCILE -> PLAN, sem escrita
  run --apply      = pipeline completo, com IMPORT READY e AUDIT
  auto-update      = habilitado por padrão, canal stable, com rollback
  Network/Hypervisor schedulers = desabilitados por padrão
EOF
    ;;
  init|configure) exec "$PYTHON" "$BASE/modules/product/configurator_v2.py" "$@" ;;
  check) check_product ;;
  self-test) exec "$PYTHON" "$BASE/modules/product/selftest.py" --base "$BASE" "$@" ;;
  health) exec "$PYTHON" "$BASE/modules/product/health.py" "$@" ;;
  discover) exec "$PYTHON" "$BASE/modules/discovery/network_v5.py" "$@" ;;
  classify) exec "$PYTHON" "$BASE/modules/inventory/classifier_v8.py" "$@" ;;
  reconcile) exec "$PYTHON" "$BASE/modules/inventory/reconciler_v5.py" "$@" ;;
  plan) exec "$PYTHON" "$BASE/modules/inventory/planner_v11.py" "$@" ;;
  inventory|prepare) exec "$PYTHON" "$BASE/modules/inventory/pipeline.py" "$@" ;;
  import) exec "$PYTHON" "$BASE/modules/importers/importer_v12.py" "$@" ;;
  audit) exec "$PYTHON" "$BASE/modules/auditors/auditor_v11.py" "$@" ;;
  run) exec "$PYTHON" "$BASE/modules/product/runner.py" "$@" ;;
  scheduled-run) exec "$PYTHON" "$BASE/modules/product/runner.py" --scheduled ;;
  status) exec "$PYTHON" "$BASE/modules/product/status.py" ;;
  hypervisor) hypervisor_dispatch "$@" ;;
  update) update_dispatch "$@" ;;
  scheduler)
    action="${1:-status}"
    case "$action" in
      enable) scheduler_enable ;;
      disable) scheduler_disable ;;
      status) systemctl status netbox-discovery.timer --no-pager || true ;;
      *) echo "Uso: netbox-discovery scheduler {enable|disable|status}" >&2; exit 2 ;;
    esac
    ;;
  *) echo "Comando inválido: $COMMAND" >&2; echo "Use: netbox-discovery help" >&2; exit 2 ;;
esac
